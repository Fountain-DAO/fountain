{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fountain",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-03",
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    // Prerendered pages are built as /page/index.html. Serve them at /page, the URL the
    // site links to, and redirect /page/ there, instead of the default trailing slash.
    "html_handling": "drop-trailing-slash",
  },
  "routes": [
    {
      "pattern": "fountain.markets",
      "custom_domain": true,
    },
  ],
  "vars": {
    // X user ids (comma-separated) that can join without an invite and create unlimited invites.
    "ADMIN_X_USER_IDS": "1010812501611565056",
  },
  "triggers": {
    // Records claims whose settlement clock has filled, and pays out.
    "crons": ["* * * * *"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fountain",
      "database_id": "2379e64b-39f0-4162-91f8-c66eb31863ec",
      "migrations_dir": "migrations",
    },
  ],
}
